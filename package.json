{
  "name": "@lw-financial/monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter './apps/*' dev",
    "dev:frontend": "bun run --filter './apps/frontend' dev",
    "dev:backend": "bun run --filter './apps/backend' dev",
    "build": "bun run --filter './apps/*' build",
    "build:frontend": "bun run --filter './apps/frontend' build",
    "db:migrate:deploy": "bun run --filter './apps/backend' prisma:deploy",
    "start:frontend": "bun run --filter './apps/frontend' start",
    "start:backend": "bun run --filter './apps/backend' start",
    "lint": "bun run --filter './packages/*' lint && bun run --filter './apps/*' lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "bun run --filter './packages/*' type-check && bun run --filter './apps/*' type-check",
    "test": "bun run --filter './packages/*' test && bun run --filter './apps/*' test",
    "clean": "bun run --filter './packages/*' clean && bun run --filter './apps/*' clean",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3"
  }
}
