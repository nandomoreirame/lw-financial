{
  "name": "@lw-financial/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "prebuild": "bun run db:generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "backfill:codes": "tsx scripts/backfill-account-codes.ts",
    "email": "email dev --dir src/email/templates --port 3003",
    "test": "NODE_ENV=test bun test"
  },
  "prisma": {
    "seed": "bun run prisma:seed"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@lw-financial/shared": "workspace:*",
    "@react-email/components": "1.0.1",
    "@react-email/render": "^2.0.0",
    "bcrypt": "^6.0.0",
    "better-auth": "^1.4.4",
    "express": "^4.18.2",
    "fastify": "^5.6.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^7.0.11",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.4",
    "@prisma/client": "^5.7.1",
    "@react-email/preview-server": "5.0.5",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "prisma": "^5.7.1",
    "react-email": "5.0.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
