        {
          "name": "List Accounts",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const accounts = pm.response.json();",
                  "    if (Array.isArray(accounts) && accounts.length > 0) {",
                  "        // Salva o código da primeira conta",
                  "        const firstAccount = accounts[0];",
                  "        if (firstAccount.code) {",
                  "            pm.environment.set('account_code', firstAccount.code);",
                  "            console.log('Código da conta salvo:', firstAccount.code);",
                  "        }",
                  "        ",
                  "        // Salva o ID da primeira conta",
                  "        if (firstAccount.id) {",
                  "            pm.environment.set('account_id', firstAccount.id);",
                  "        }",
                  "        ",
                  "        // Se houver mais de uma conta, salva a segunda como destino",
                  "        if (accounts.length > 1 && accounts[1].code) {",
                  "            pm.environment.set('destination_account_code', accounts[1].code);",
                  "            if (accounts[1].id) {",
                  "                pm.environment.set('destination_account_id', accounts[1].id);",
                  "            }",
                  "        }",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
